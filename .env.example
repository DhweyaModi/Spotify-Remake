# 1. Copy this file to a new file called .env
# 2. Paste your values from Supabase: Project Settings -> API
# 3. Restart `npm run start`  (Vite only reads .env when it starts)
#
# Use the PUBLIC key (anon / publishable).
# NEVER paste the secret / service_role key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
